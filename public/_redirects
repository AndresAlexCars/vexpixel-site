# Proxy hacia el servidor Express (Cloudflare Tunnel desde Termux).
# El navegador sigue hablando con pixelwalls.jordvex.xyz, así que no hay CORS ni cambios en api.js.
# status 200 = reescritura (proxy), la URL del navegador no cambia.
# Nota: /api/instagram/* lo atiende la Pages Function (functions/api/instagram/download.js) por _routes.json.

/wallpapers/* https://api.jordvex.xyz/wallpapers/:splat 200
/videos/*     https://api.jordvex.xyz/videos/:splat   200
/media/*      https://api.jordvex.xyz/media/:splat    200
/sound/*      https://api.jordvex.xyz/sound/:splat    200
/music/*      https://api.jordvex.xyz/music/:splat    200
/healthz      https://api.jordvex.xyz/healthz         200
/*      /index.html                          200
